# =============================================================================
# Mind Map Generator — Backend Environment Configuration
# =============================================================================

# Server & Frontend
PORT=8000
FRONTEND_URL=http://localhost:3000

# PostgreSQL / Supabase Database URL
# Direct connection or connection pooler (e.g. port 5432 or 6543)
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres

# Supabase Auth & Storage API Keys
SUPABASE_URL=https://[YOUR-PROJECT-REF].supabase.co
SUPABASE_ANON_KEY=eyJhbGciOi...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...

# Primary LLM Configuration (Groq recommended for ultra-fast generation)
LLM_PROVIDER=groq
LLM_MODEL=llama-3.3-70b-versatile
LLM_API_KEY=gsk_...
LLM_MAX_OUTPUT_TOKENS=8000
LLM_TIMEOUT_S=90

# Generation Settings
MAX_GENERATION_RETRIES=2
GEN_RATE_LIMIT_PER_HOUR=30

# Redis & Async Worker Integration
REDIS_URL=redis://localhost:6379
BACKEND_INTERNAL_URL=http://localhost:8000
# Only direct worker connections may read /internal/config (also /api/internal/config).
# Block both paths at public reverse proxies. For a remote worker, set its private IP here.
PIPELINE_CONFIG_WORKER_IPS=127.0.0.1,::1
# Initial flags used until an admin saves an override. Match the worker environment.

# Service-to-Service internal secret (NEW-01: generate a secure random 32+ char secret)
INTERNAL_SERVICE_KEY=
# Optional separate key. If configured, use the same value on API and worker.
PIPELINE_CONFIG_SERVICE_KEY=
ENABLE_TWO_PASS=false
RESEARCH_ENGINE=subgraph
IMAGE_EXTRACTOR=gemini

# Cookie Security
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
COOKIE_DOMAIN=
