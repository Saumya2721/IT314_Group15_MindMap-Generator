# Copy to .env and fill in real values. NEVER commit the real .env.
# Run:  cp .env.example .env

# ---------------------------------------------------------------------------
# ARQ / Redis (job queue)
# ---------------------------------------------------------------------------
REDIS_URL=redis://localhost:6379
ARQ_MAX_JOBS=4
# Must exceed the slowest realistic generation (detailed mode can take ~3 min).
ARQ_JOB_TIMEOUT_S=300

# ---------------------------------------------------------------------------
# Primary LLM — generation only (kept generic; "groq" is the reference adapter)
# ---------------------------------------------------------------------------
LLM_PROVIDER=groq
LLM_MODEL=llama-3.3-70b-versatile
LLM_API_KEY=gsk_...
LLM_API_BASE=
LLM_MAX_OUTPUT_TOKENS=8000
LLM_TIMEOUT_S=90

# ---------------------------------------------------------------------------
# Decision model — Jev / TypeSafe System One (classify/route/score only)
# Disabled or misconfigured? The pipeline falls back to the LLM then a
# heuristic — it always works (NFR-07: graceful degradation).
# ---------------------------------------------------------------------------
DECISION_MODEL_ENABLED=true
DECISION_MODEL_PROVIDER=jev
TYPESAFE_API_KEY=
TYPESAFE_API_BASE=https://api.typesafe.ai/v1
DECISION_MODEL_TIMEOUT_S=3

# ---------------------------------------------------------------------------
# Embeddings:
# Option 1 (Recommended & 100% Free): FastEmbed (local ONNX, zero API keys, no cost)
#   EMBEDDING_PROVIDER=fastembed
#   EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
#   EMBEDDING_DIMENSION=384
#
# Option 2: Hugging Face (uses new router.huggingface.co endpoint, requires paid credits)
#   EMBEDDING_PROVIDER=huggingface
#   EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
#   EMBEDDING_DIMENSION=384
#   EMBEDDING_API_KEY=hf_...
#   EMBEDDING_API_BASE=https://router.huggingface.co/hf-inference/models
# ---------------------------------------------------------------------------
EMBEDDING_PROVIDER=fastembed
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_DIMENSION=384
EMBEDDING_API_KEY=
EMBEDDING_API_BASE=https://router.huggingface.co/hf-inference/models
EMBEDDING_BATCH_SIZE=32

# ---------------------------------------------------------------------------
# Pinecone vector store
# ---------------------------------------------------------------------------
PINECONE_API_KEY=pcsk_...
PINECONE_INDEX=mindmap-chunks
# Convex-combination hybrid weight: 1.0 = dense-only, 0.0 = sparse-only.
PINECONE_DENSE_WEIGHT=0.5

# ---------------------------------------------------------------------------
# Research tools (optional — worker degrades gracefully without these)
# ---------------------------------------------------------------------------
SEARCH_PROVIDER=tavily
SEARCH_API_KEY=       # Tavily key; leave blank to disable web_search tool
ARXIV_API_BASE=http://export.arxiv.org/api/query
TOOL_TIMEOUT_S=15

# ---------------------------------------------------------------------------
# Generation behaviour
# ---------------------------------------------------------------------------
MAX_GENERATION_RETRIES=2
DEFAULT_DETAIL_LEVEL=       # blank => Jev/heuristic infers it
RAG_TOP_K=12
RAG_RERANK_TOP_K=6
OVERVIEW_LATENCY_BUDGET_S=30
DETAILED_LATENCY_BUDGET_S=180
